    "marked": "^18.0.14",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
