# ─────────────────────────────────────────────────────────────
# Ayuntamiento de Jaca — variables de entorno (EJEMPLO)
# Copie este archivo a `.env` y sustituya los valores.
# NUNCA suba el archivo `.env` real al repositorio.
# ─────────────────────────────────────────────────────────────

# Base de datos PostgreSQL
#  - Desarrollo sin Docker: `npm run db:local` (puerto 5433)
#  - Docker Compose: el host es `db` (ver docker-compose.yml)
DATABASE_URL="postgresql://ayto:CAMBIAR_PASSWORD@localhost:5433/ayto_jaca"

# Credenciales de PostgreSQL que usa Docker Compose para crear la BD
POSTGRES_USER="ayto"
POSTGRES_PASSWORD="CAMBIAR_PASSWORD_LARGA_Y_ALEATORIA"
POSTGRES_DB="ayto_jaca"

# Autenticación (Auth.js / NextAuth v5)
# Genere un secreto con:  npx auth secret   o   openssl rand -base64 32
AUTH_SECRET="GENERAR_UN_SECRETO_ALEATORIO_DE_32_BYTES"
# URL pública de la web (se usa también para canonical, sitemap y Open Graph)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="${AUTH_SECRET}"
# Necesario detrás de Nginx u otro proxy inverso
AUTH_TRUST_HOST="true"

# URL canónica del sitio (sin barra final)
SITE_URL="http://localhost:3000"

# Usuario administrador inicial (solo lo usa `npm run db:seed` / `npm run admin:create`)
# Deje ADMIN_PASSWORD vacío para que el script la pida por consola.
ADMIN_EMAIL="admin@example.org"
ADMIN_NAME="Administración web"
ADMIN_PASSWORD=""

# Aviso visible "Propuesta de rediseño — demo no oficial"
NEXT_PUBLIC_DEMO_MODE="true"

# Almacenamiento de archivos subidos (imágenes y PDF)
UPLOAD_DIR="./storage/uploads"
# Tamaños máximos (MB)
UPLOAD_MAX_IMAGE_MB="5"
UPLOAD_MAX_DOCUMENT_MB="15"

# Token para ejecutar tareas programadas (publicación/caducidad) vía /api/cron/lifecycle
CRON_SECRET="GENERAR_OTRO_SECRETO_ALEATORIO"

# Email (opcional, no se usa en el MVP; preparado para newsletter/notificaciones)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Ayuntamiento de Jaca <no-reply@example.org>"
